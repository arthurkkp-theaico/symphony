{
  "description": "Enforce secret-egress policy before and after local tool calls.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/guard.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\guard.py\"",
            "timeout": 5,
            "statusMessage": "Checking secret-egress policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/guard.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\guard.py\"",
            "timeout": 5,
            "statusMessage": "Scanning tool output for credentials"
          }
        ]
      }
    ]
  }
}
